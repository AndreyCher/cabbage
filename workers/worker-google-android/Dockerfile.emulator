# syntax=docker/dockerfile:1.7
# Thin adapter over Google's supported emulator image.  A statically linked
# resolver keeps the legacy base image immutable and avoids apt dependencies.
FROM golang:1.24-bookworm AS resolver-build
WORKDIR /src
COPY workers/worker-google-android/scripts/emulator-entrypoint.go ./main.go
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags='-s -w' -o /resolver ./main.go

FROM us-docker.pkg.dev/android-emulator-268719/images/30-google-x64-no-metrics:30.1.2
COPY --from=resolver-build /resolver /opt/worker-google-android/emulator-entrypoint
ENTRYPOINT ["/opt/worker-google-android/emulator-entrypoint"]
