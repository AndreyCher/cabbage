# syntax=docker/dockerfile:1.7
# Self-owned debug gateway: talks to the official emulator's
# EmulatorController gRPC service directly (status/GPS/hardware keys/screen).
# See scripts/gateway_server.py for why this does not use the image's legacy
# "android.emulation.control.Rtc" WebRTC service.
FROM python:3.12-slim
ARG ANDROID_TOOLS_BASE_COMMIT=3bce36588f5e683330f968538a2a55a66ed54c0e
RUN apt-get update && apt-get install -y --no-install-recommends git \
 && rm -rf /var/lib/apt/lists/* \
 && git clone --filter=blob:none --sparse https://android.googlesource.com/platform/tools/base /opt/tools-base \
 && git -C /opt/tools-base checkout "$ANDROID_TOOLS_BASE_COMMIT" \
 && git -C /opt/tools-base sparse-checkout set emulator/proto \
 && python -m pip install --no-cache-dir aiohttp grpcio grpcio-tools \
 && mkdir -p /opt/worker-google-android-gateway/proto \
 && python -m grpc_tools.protoc \
      -I/opt/tools-base/emulator/proto \
      -I/usr/local/lib/python3.12/site-packages/grpc_tools/_proto \
      --python_out=/opt/worker-google-android-gateway/proto \
      --grpc_python_out=/opt/worker-google-android-gateway/proto \
      /opt/tools-base/emulator/proto/emulator_controller.proto \
 && rm -rf /opt/tools-base
COPY workers/worker-google-android/scripts/gateway_server.py /opt/worker-google-android-gateway/gateway_server.py
WORKDIR /opt/worker-google-android-gateway
ENTRYPOINT ["python3", "gateway_server.py"]
