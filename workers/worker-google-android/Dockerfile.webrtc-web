# syntax=docker/dockerfile:1.7
# Self-owned static debug frontend (see web/index.html and scripts/gateway_server.py
# for why this replaced the vendored WebRTC React app).
FROM nginx:1.27-alpine
COPY workers/worker-google-android/nginx/webrtc.conf /etc/nginx/conf.d/default.conf
COPY workers/worker-google-android/web/ /usr/share/nginx/html/
