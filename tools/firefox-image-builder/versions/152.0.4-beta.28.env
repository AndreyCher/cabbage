# Reproducible build of the known v152.0.4-beta.28 Camoufox release.
CAMOUFOX_REPO="https://github.com/daijro/camoufox.git"
CAMOUFOX_REF="v152.0.4-beta.28"

TARGET_OS="linux"
TARGET_ARCH="x86_64"

# Empty = use version/release pinned by upstream.sh at CAMOUFOX_REF.
FIREFOX_VERSION_OVERRIDE=""
CAMOUFOX_RELEASE_OVERRIDE=""

IMAGE_TAG="worker-firefox-base:152.0.4-beta.28-ubo1"
PYTHON_BASE_IMAGE="python:3.12-slim-bookworm"

# Mozilla Add-ons release pinned by exact file URL and digest.
UBO_VERSION="1.73.0"
UBO_URL="https://addons.mozilla.org/firefox/downloads/file/4940584/ublock_origin-1.73.0.xpi"
UBO_SHA256="bccc51a773150af4af6e1fd62c7bfdeb7238b79ff2381b998fa9f2e38f64786a"

# Pin source-build dependencies. Floating ubuntu:latest/current Rust already
# caused this known Firefox source to fail on a later rebuild.
SOURCE_BUILDER_BASE_IMAGE="ubuntu:24.04"
RUST_TOOLCHAIN="nightly-2026-07-01"

# Firefox compilation tuning. "auto" caps parallelism by both the CPU count and
# Docker's memory limit. The defaults intentionally leave headroom for large
# Rust/C++ compiler processes; set an integer only for a deliberate override.
BUILD_JOBS="auto"
BUILD_MEMORY_RESERVE_MIB="2048"
BUILD_MEMORY_PER_JOB_MIB="10240"

# Reuse the deterministic source-builder image unless a clean rebuild is
# explicitly required.
REBUILD_BUILDER="false"

# Remove the multi-gigabyte source-builder image after the run. Enable only
# when another build of the same Camoufox version is expected soon or when the
# intermediate image is needed for debugging.
KEEP_BUILDER_IMAGE="false"

# Keep failed/successful source workspace for debugging if desired.
KEEP_WORKDIR="false"
