# Advanced example: try the current Camoufox patch stack against another
# upstream Firefox version. This may fail when Firefox changes conflict with
# Camoufox patches. Prefer a Camoufox ref/tag that officially supports the
# desired Firefox version whenever possible.

CAMOUFOX_REPO="https://github.com/daijro/camoufox.git"
CAMOUFOX_REF="main"

TARGET_OS="linux"
TARGET_ARCH="x86_64"

FIREFOX_VERSION_OVERRIDE="153.0.0"
CAMOUFOX_RELEASE_OVERRIDE="custom.1"

IMAGE_TAG="worker-firefox-base:153.0.0-custom.1"
PYTHON_BASE_IMAGE="python:3.12-slim-bookworm"

# Retain the source-builder only when repeated compilation or debugging is
# expected. The default false avoids leaving a multi-gigabyte image behind.
KEEP_BUILDER_IMAGE="false"

KEEP_WORKDIR="true"
